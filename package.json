{
  "name": "prompt-seen",
  "version": "0.0.0",
  "private": true,
  "description": "A browsable, searchable library of tested image prompts and templates, published as a static site.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "tsx scripts/config-gen.ts",
    "dev": "npm run gen && npm run content:build && next dev",
    "content:validate": "npm run gen && tsx scripts/content-validate.ts",
    "content:build": "tsx scripts/content-build.ts",
    "build": "npm run gen && npm run content:build && next build && tsx scripts/package.ts",
    "typecheck": "npm run gen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve": "sh scripts/nginx.sh",
    "deploy:cloudflare:prepare": "tsx scripts/deploy-cloudflare.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
