{
  "name": "prompt-seen",
  "version": "0.0.0",
  "private": true,
  "description": "A browsable, searchable library of tested image prompts and templates, published as a static site.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "tsx scripts/config-gen.ts",
    "dev": "npm run gen && tsx scripts/dev.ts",
    "content:validate": "npm run gen && tsx scripts/content-validate.ts",
    "content:build": "tsx scripts/content-build.ts",
    "content:new": "tsx scripts/content-new.ts",
    "content:export": "npm run gen && tsx scripts/content-export.ts",
    "media:import": "tsx scripts/media-import.ts",
    "build": "npm run gen && npm run content:build && next build && tsx scripts/package.ts",
    "typecheck": "npm run gen && tsc --noEmit",
    "tokens:check": "tsx scripts/tokens-check.ts",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "npm run gen && storybook dev -p 6006",
    "storybook:build": "npm run gen && storybook build --quiet -o storybook-static",
    "serve": "sh scripts/nginx.sh",
    "deploy:cloudflare:prepare": "tsx scripts/deploy-cloudflare.ts"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "minisearch": "7.2.0",
    "motion": "13.5.1",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "github-slugger": "2.0.0",
    "prettier": "3.9.10",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "storybook": "10.6.1",
    "subset-font": "2.9.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "vite": "8.3.1",
    "vitest": "5.0.5"
  }
}
