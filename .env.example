# Environment variables (design doc §4.1, §15.4.2). None is needed to run the site locally:
# `npm install && npm run dev` works with content/site.yaml alone.
#
# Copy to .env.local (git-ignored) and load it into your shell before running scripts:
#   set -a; . ./.env.local; set +a
# Variables set in the shell or in CI win over content/site.yaml.

# --- Build settings (override content/site.yaml) ------------------------------------------
# production: only enabled locales, indexable. preview (default): drafts and preview locales, noindex.
BUILD_MODE=preview
# The canonical host, without a path or trailing slash.
SITE_ORIGIN=https://example.com
# The path the site lives under; empty for the root of the host. Changing it needs a new build.
BASE_PATH=
# How public addresses are formed; change only when the host puts the language first.
# URL_PATTERN={basePath}/{locale}/{path}
# Another content directory, e.g. a private content repository checked out next to this one.
# CONTENT_DIR=../my-content
# Build identifier shared by pages and data files; defaults to the Git commit.
# BUILD_ID=
# CDN address of the image storage; empty: images are files of the build (local driver).
# MEDIA_BASE_URL=https://media.example.com

# --- Object storage (media:import, media:sync) -----------------------------------------------
# Only for maintainers who upload images. Never commit real values.
# MEDIA_STORAGE=s3
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_BUCKET=prompt-seen-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Deploy and outside services (docs/operations.md) ---------------------------------------
# IndexNow key (8–128 of a–z A–Z 0–9 -): published as {BASE_PATH}/{key}.txt by the build.
# INDEXNOW_KEY=
# Cloudflare Pages, for deploy:rollback and manual deploys.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_PAGES_PROJECT=prompt-seen
# Optional private JavaScript module for production artifact customization (docs/operations.md).
# Locally, .artifacts/deploy/prepare.mjs is also supported. In Actions, use a production environment secret.
# PRODUCTION_DEPLOY_HOOK=
# The hook receives DEPLOY_ARTIFACT_DIR automatically, pointing to the prepared upload directory.
